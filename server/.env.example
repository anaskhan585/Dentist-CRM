# Copy to .env and adjust before running the API
NODE_ENV=development
PORT=5000

# Local Mongo, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/dentist-crm

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed front-end origins
CLIENT_ORIGIN=http://localhost:5173
